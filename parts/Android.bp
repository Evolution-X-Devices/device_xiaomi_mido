android_app {
    name: "XiaomiParts",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "androidx.core_core",
        "org.lineageos.settings.resources",
    ],

    required: [
        "init.xiaomiparts_appopt.rc",
        "xiaomiparts_appopt",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
        shrink_resources: true,
    },
}

sh_binary {
    name: "xiaomiparts_appopt",
    src: "appopt/xiaomiparts_appopt.sh",
    filename: "xiaomiparts_appopt",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "init.xiaomiparts_appopt.rc",
    src: "appopt/init.xiaomiparts_appopt.rc",
    sub_dir: "init",
    system_ext_specific: true,
}
